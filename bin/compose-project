#!/usr/bin/env bash
# Give a git worktree its own Docker Compose stack, started from a copy of the
# main checkout's Postgres data.
#
# For a compose file that pins its project with `name: <name>`, which would
# otherwise make every checkout share one stack, and whose services are reached
# through OrbStack's container hostnames (<service>.<name>.orb.local) rather
# than fixed host ports, so stacks can run side by side. Run from the directory
# that holds the compose file, in a linked worktree; in the main checkout both
# commands do nothing.
#
#   compose-project setup <env-file>
#     Write COMPOSE_PROJECT_NAME=<project> to <env-file> and point its OrbStack
#     hostnames at that project. <env-file> must already use *.<name>.orb.local
#     hostnames. If the compose file keeps Postgres data in ./.pgdata, first
#     copy the main checkout's .pgdata here; the main stack's database is
#     stopped while copying. Run it before anything starts the stack. Safe to
#     re-run; never overwrites a copy.
#   compose-project down
#     `docker compose down -v` this worktree's project. It can't reach the
#     main checkout's stack, which keeps <name>.
#
# <project> is <name>-<worktree directory>-<hash of its path>, so worktrees
# with the same directory name in different places get different stacks.
set -euo pipefail

die() { echo "compose-project: $*" >&2; exit 1; }

usage="usage: compose-project setup <env-file> | compose-project down"
cmd="${1:-}"
case "$cmd" in
  setup) env_file="${2:-}"; [ -n "$env_file" ] || die "$usage" ;;
  down) ;;
  *) die "$usage" ;;
esac

git_dir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || die "not in a git checkout"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
[ "$git_dir" != "$common_dir" ] || exit 0

compose=""
for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
  [ -f "$f" ] && { compose="$f"; break; }
done
[ -n "$compose" ] || die "no compose file in $PWD"

top="$(git rev-parse --show-toplevel)"
main="$(dirname "$common_dir")"
prefix="$(git rev-parse --show-prefix)"

name="$(sed -n -E "s/^name:[[:space:]]*['\"]?([^'\"[:space:]]+).*/\1/p" "$compose" | head -1)"
[ -n "$name" ] || die "$compose has no top-level name:"
[[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "unsupported project name: $name"

# Compose project names double as an OrbStack DNS label: [a-z0-9_-], <= 63.
worktree="$(basename "$top" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')"
hash="$(printf '%s' "$top" | cksum | cut -d' ' -f1)"
project="$(printf '%s' "$name-$worktree" | cut -c1-56 | sed 's/[-_]*$//')-$(printf '%06x' $((hash % 16777216)))"

# A running Postgres can't be copied consistently, so the main stack's
# database (the container in project <name>, started from the main checkout,
# that mounts .pgdata) is stopped for the copy. On APFS, cp -c clones it
# instantly and shares blocks until either side changes.
copy_pgdata() {
  local src="$main/${prefix}.pgdata" dest id running="" ok=0
  dest="$(sed -n -E "s#.*\./\.pgdata:([^[:space:]:'\"]+).*#\1#p" "$compose" | head -1)"
  [ -n "$dest" ] && [ ! -e .pgdata ] && [ -d "$src" ] || return 0
  for id in $(docker ps -q --filter "label=com.docker.compose.project=$name" \
    --filter "label=com.docker.compose.project.working_dir=$main${prefix:+/${prefix%/}}"); do
    if docker inspect -f '{{range .Mounts}}{{println .Destination}}{{end}}' "$id" | grep -qxF "$dest"; then
      running="$running $id"
    fi
  done
  # shellcheck disable=SC2086
  [ -z "$running" ] || docker stop $running >/dev/null
  if cp -c -Rp "$src" .pgdata 2>/dev/null; then
    ok=1
  else
    rm -rf .pgdata
    if cp -Rp "$src" .pgdata; then ok=1; else rm -rf .pgdata; fi
  fi
  # shellcheck disable=SC2086
  [ -z "$running" ] || docker start $running >/dev/null
  [ "$ok" = 1 ] || die "couldn't copy $src"
  echo "compose-project: copied the main checkout's Postgres data"
}

case "$cmd" in
  setup)
    # Hostnames already pointing at an earlier project name are moved too.
    old="$( { [ ! -f "$env_file" ] || sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$env_file"; } | tail -1)"
    hosts="$name${old:+|$old}"
    grep -qsE "\.($hosts)\.orb\.local" "$env_file" ||
      die "$env_file has no *.$name.orb.local hostnames. A worktree's stack needs OrbStack's container hostnames instead of fixed host ports, or it collides with the main stack; set them up first."
    copy_pgdata
    tmp="$(mktemp)"
    {
      { grep -v '^COMPOSE_PROJECT_NAME=' "$env_file" || true; } | sed -E "s/\.($hosts)\.orb\.local/.$project.orb.local/g"
      echo "COMPOSE_PROJECT_NAME=$project"
    } >"$tmp"
    cat "$tmp" >"$env_file" && rm -f "$tmp"
    echo "compose-project: this worktree's stack is $project"
    ;;
  down)
    docker compose -p "$project" down -v --remove-orphans
    ;;
esac
