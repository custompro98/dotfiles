#!/usr/bin/env bash
# Popup: confirm, then close this workspace. The workspace.closed hook
# (on-workspace-closed) runs the archive script and deletes the worktree
# checkout. The branch is kept, like Conductor.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

ws="${HERDR_ACTIVE_WORKSPACE_ID:?no active workspace}"
info="$("$HERDR" workspace get "$ws")"
path="$(jq -r '.result.workspace.worktree | select(.is_linked_worktree) | .checkout_path // empty' <<<"$info")"
[ -n "$path" ] || die_popup "this workspace isn't a linked worktree; nothing to archive"

branch="$(git -C "$path" branch --show-current)"
printf '\033[1marchive %s\033[0m (%s)\n' "$(jq -r '.result.workspace.label' <<<"$info")" "$path"
git -C "$path" status --short
read -r -p "close and archive? this is final; branch $branch is kept, uncommitted changes are stashed [y/N] " answer
[ "$answer" = y ] || exit 0

"$HERDR" workspace close "$ws" >/dev/null || die_popup "workspace close failed"
