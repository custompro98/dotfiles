#!/usr/bin/env bash
# Popup: fuzzy-pick a repo and focus its workspace, creating one for the main
# checkout if it isn't open yet.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

repo="$(flow_pick_repo)" || exit 0
# Focuses the repo's workspace when it's already open, else opens one.
out="$("$HERDR" worktree open --cwd "$repo" --path "$repo" --focus 2>&1)" ||
  die_popup "$out"
