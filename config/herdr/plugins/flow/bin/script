#!/usr/bin/env bash
# Run a conductor.json script (setup | run | archive) in the current directory.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

name="${1:?usage: script <setup|run|archive>}"
dir="${2:-$PWD}"

cd "$dir"
flow_export_env "$dir"
cmd="$(flow_script "$dir" "$name")"

if [ -z "$cmd" ]; then
  printf '\033[2mno scripts.%s in conductor.json\033[0m\n' "$name"
  exit 0
fi

printf '\033[36m▶ %s\033[0m %s\n' "$name" "$cmd"
exec bash -c "$cmd"
