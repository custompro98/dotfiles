#!/usr/bin/env bash
# workspace.closed hook: archive a closed worktree workspace like Conductor.
# Run the archive script, save HEAD and uncommitted work under
# refs/flow/archive/ (bin/unarchive restores it), and delete the checkout. The
# branch is kept. Repo workspaces (main checkouts) are left alone.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

event="${HERDR_PLUGIN_EVENT_JSON:-}"
[ -n "$event" ] || die "missing HERDR_PLUGIN_EVENT_JSON"

path="$(jq -r '[.. | objects | .worktree? | objects | select(.is_linked_worktree) | .checkout_path // empty][0] // empty' <<<"$event")"
[ -n "$path" ] && [ -d "$path" ] || exit 0

notify() {
  "$HERDR" notification show "$1" --body "$2" >/dev/null || true
}

name="$(basename "$path")"
label="$(jq -r '[.. | objects | .workspace? | objects | .label // empty][0] // empty' <<<"$event")"
branch="$(git -C "$path" branch --show-current)"
root="$(flow_root_path "$path")"

"$FLOW_BIN/script" archive "$path" ||
  notify "flow: archive script failed for ${branch:-$name}" "herdr plugin log list --plugin custompro98.flow"

# Keep the checkout rather than lose work that couldn't be saved.
if ! err="$(flow_archive_save "$path" "${label:-$name}" 2>&1 >/dev/null)"; then
  notify "flow: couldn't archive $name" "$err"
  die "$err"
fi

if ! err="$(git -C "$root" worktree remove --force "$path" 2>&1)"; then
  notify "flow: couldn't remove $path" "$err"
  die "$err"
fi

notify "flow: archived $name" "restore with prefix+shift+o"
