#!/usr/bin/env bash
# workspace.closed hook: worktree checkouts are disposable. Run the repo's
# teardown script ([scripts] archive, e.g. `compose down -v`), then delete the
# checkout with everything in it: uncommitted, untracked and ignored files
# (node_modules, build output). Nothing is archived; the branch is kept and
# bin/reopen (prefix+shift+o) re-creates a checkout of it. bin/close refuses
# to close a checkout with pending changes, but closing any other way discards
# them. Repo workspaces (main checkouts) are left alone.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

event="${HERDR_PLUGIN_EVENT_JSON:-}"
[ -n "$event" ] || die "missing HERDR_PLUGIN_EVENT_JSON"

path="$(jq -r '[.. | objects | .worktree? | objects | select(.is_linked_worktree) | .checkout_path // empty][0] // empty' <<<"$event")"
[ -n "$path" ] && [ -d "$path" ] || exit 0

notify() {
  "$HERDR" notification show "$1" --body "$2" >/dev/null || true
}

name="$(basename "$path")"
branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
root="$(flow_root_path "$path")"

"$FLOW_BIN/script" archive "$path" ||
  notify "flow: teardown script failed for ${branch:-$name}" "herdr plugin log list --plugin custompro98.flow"

# --force twice also removes locked worktrees. If git still refuses (e.g. the
# checkout has submodules), delete the directory and prune its metadata.
if ! err="$(git -C "$root" worktree remove --force --force "$path" 2>&1)"; then
  if ! rm -rf "$path" || ! git -C "$root" worktree prune; then
    notify "flow: couldn't remove $path" "$err"
    die "$err"
  fi
fi

# Drop the per-repo worktrees directory once its last checkout is gone.
parent="$(dirname "$path")"
[ "$(dirname "$parent")" != "$(flow_worktrees_dir)" ] || rmdir "$parent" 2>/dev/null || true
