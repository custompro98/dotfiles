#!/usr/bin/env bash
# workspace.closed hook: worktree checkouts are disposable. Run the archive
# script, then delete the checkout; the branch is kept and bin/reopen
# (prefix+shift+o) re-creates it. bin/close refuses to close a checkout with
# pending changes, but herdr can close workspaces other ways, so a checkout
# that still has some is kept (and listed by reopen). Repo workspaces (main
# checkouts) are left alone.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

event="${HERDR_PLUGIN_EVENT_JSON:-}"
[ -n "$event" ] || die "missing HERDR_PLUGIN_EVENT_JSON"

path="$(jq -r '[.. | objects | .worktree? | objects | select(.is_linked_worktree) | .checkout_path // empty][0] // empty' <<<"$event")"
[ -n "$path" ] && [ -d "$path" ] || exit 0

notify() {
  "$HERDR" notification show "$1" --body "$2" >/dev/null || true
}

name="$(basename "$path")"
branch="$(git -C "$path" branch --show-current)"
root="$(flow_root_path "$path")"
# Before the archive script, which may leave files behind.
pending="$(flow_pending_changes "$path")"

"$FLOW_BIN/script" archive "$path" ||
  notify "flow: archive script failed for ${branch:-$name}" "herdr plugin log list --plugin custompro98.flow"

if [ -n "$pending" ]; then
  notify "flow: kept ${branch:-$name}" "it has pending changes in $path; reopen it with prefix+shift+o"
  exit 0
fi

if ! err="$(git -C "$root" worktree remove --force "$path" 2>&1)"; then
  notify "flow: couldn't remove $path" "$err"
  die "$err"
fi
