#!/usr/bin/env bash
# Print CONDUCTOR_* KEY=VALUE lines when a directory is inside a linked git
# worktree; print nothing otherwise. Used by the fish conf.d hook.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

dir="${1:-$PWD}"
git_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || exit 0
common_dir="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)"
[ "$git_dir" != "$common_dir" ] || exit 0

flow_env_lines "$(git -C "$dir" rev-parse --show-toplevel)"
