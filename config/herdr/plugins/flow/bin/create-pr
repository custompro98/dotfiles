#!/usr/bin/env bash
# Ask this workspace's agent to commit, push, and open a PR, like Conductor's
# "Create PR" button.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

ws="${HERDR_ACTIVE_WORKSPACE_ID:?no active workspace}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

agent="$(flow_agent_name "$ws")"
"$HERDR" agent get "$agent" >/dev/null 2>&1 || die_popup "no agent named $agent in this workspace"

default="$(flow_default_branch "$cwd")"
prompt="Create a pull request for this branch. Commit any uncommitted work with a clear message, push the branch to origin, then open a PR against $default with \`gh pr create\`, writing a concise title and description from the full diff against $default. If a PR already exists, push and update its description instead. Reply with the PR URL."
extra="$(flow_settings "$cwd" | jq -r '.prompts.create_pr // empty')"
[ -z "$extra" ] || prompt+=$'\n\n'"$extra"

out="$("$HERDR" agent prompt "$agent" "$prompt" 2>&1)" || die_popup "$out"
"$HERDR" agent focus "$agent" >/dev/null 2>&1 || true
