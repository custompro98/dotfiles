#!/usr/bin/env bash
# Popup (prefix+shift+d): close the active workspace. Closing a worktree
# workspace deletes its checkout (on-workspace-closed), so this refuses while
# the checkout has pending changes (flow_pending_changes): commit, stash or
# discard them first. The branch stays; prefix+shift+o reopens it.
#   close [workspace-id]
set -euo pipefail
source "$(dirname "$0")/lib.sh"

ws="${1:-${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}}"
[ -n "$ws" ] || die_popup "no active workspace"

info="$("$HERDR" workspace get "$ws" 2>&1)" || die_popup "$info"
label="$(jq -r '.result.workspace.label // empty' <<<"$info")"
path="$(jq -r '.result.workspace.worktree // {} | select(.is_linked_worktree == true) | .checkout_path // empty' <<<"$info")"

if [ -n "$path" ] && [ -d "$path" ]; then
  pending="$(flow_pending_changes "$path")"
  if [ -n "$pending" ]; then
    printf '\033[1mcan'\''t close %s\033[0m: %s has pending changes\n\n%s\n\n' "${label:-$ws}" "$path" "$pending"
    die_popup "commit, stash or discard them first"
  fi
fi

read -r -n 1 -p "close ${label:-$ws}? [y/N] " answer
echo
[[ "$answer" == [yY] ]] || exit 0

out="$("$HERDR" workspace close "$ws" 2>&1)" || die_popup "$out"
